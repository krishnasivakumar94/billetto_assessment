<!DOCTYPE html>
<html>
  <head>
    <title>Billette Assessment</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="clerk-publishable-key" content="<%= ENV.fetch("CLERK_PUBLISHABLE_KEY", "") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if flash[:notice] %><div class="flash flash-notice" role="status"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="flash flash-alert" role="alert"><%= flash[:alert] %></div><% end %>
    <%= yield %>
  </body>
</html>
